# Public site URL, used for canonical URLs, sitemap, and Open Graph
NEXT_PUBLIC_SITE_URL=https://deventhous.com

# Resend: email notification for each new brief
RESEND_API_KEY=
LEAD_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. "Deventhous <hello@deventhous.com>"
LEAD_FROM_EMAIL=

# Supabase: store leads (run supabase/leads.sql first). Server-only, never expose.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
